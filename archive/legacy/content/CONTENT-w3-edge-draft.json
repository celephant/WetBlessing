          "fx": "warm-veil",
          "lines": [
            {
              "speaker": "narrator",
              "text": "你的手指还按在发烫的门把上。金属热意一路爬到腕骨——门缝里，她的呼吸近得像贴着你。",
              "camera": "close_hand",
              "transition": "soft-zoom",
              "fx": "warm-veil"
            },
            {
              "speaker": "mia",
              "text": "「……进来。——或带着这点热走。」",
              "camera": "close_alt",
              "transition": "softZoomCrop",
              "fx": "breath"
            },
            {
              "speaker": "narrator",
              "text": "门还没开。免费吊够烫——锁合上之后才算真正过墙。推，还是装没事。",
              "camera": "close_hand",
              "transition": "softZoomCrop",
              "fx": "tension_hold"
            }
          ]
