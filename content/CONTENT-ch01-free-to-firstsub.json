                    "affection": 1
                  }
                }
              }
            },
            {
              "choiceId": "c_jade_go",
              "text": "躲开：填完就走。",
              "next": "n_mia_tease_auto",
              "delta": {
                "tension": 1
              }
            }
          ]
        },
        {
          "nodeId": "n_mia_tease_auto",
          "type": "dialogue",
          "speaker": "narrator",
          "text": "离开登记桌时，走廊另一头 Mia 正把纸箱卡住电梯门。她没叫你——只抬眼，旧得过分的熟：像在说「忙完外面那个，还认得箱子吗」。发丝扫过肩，她自己先别开视线，哼一声走进电梯。",
          "assetId": "assets/scenes/ch01/n_mia_edge_1.webp",
          "artCue": {
            "summary": "0选项发小擦边旁白：远距熟视/发丝，不塞箱亲密操作；可复用edge或占位"
          },
          "artStatus": "ready",
          "characters": [
            "kai",
            "mia"
          ],
          "advance": "n_conflict"
        },
        {
          "nodeId": "n_dodge_corridor",
          "type": "dialogue",
          "speaker": "narrator",
          "text": "你刷卡进门。身后 Mia 的箱子落地声，Jade 那边传来一声短笑。谁都没被你接住——但晚上还会再撞上。",
          "assetId": "assets/scenes/ch01/n_dodge_corridor.webp",
          "artCue": "走廊躲开：两人未接住的余韵，无塞箱亲密；占位",
          "artStatus": "placeholder",
          "characters": [
            "kai"
          ],
          "lines": [
            {
              "speaker": "mia",
              "text": "（远处）「……行。」"
            },
            {
              "speaker": "jade",
              "text": "（更远）「装忙啊。」"
            }
          ],
          "advance": "n_conflict"
        },
        {
          "nodeId": "n_mia_edge_1",
          "type": "dialogue",
          "speaker": "mia",
          "text": "她还是把箱子边沿塞进你掌心，指节撞了一下。「别装不认识。手伸过来。」",
          "assetId": "assets/scenes/ch01/n_mia_edge_1.webp",
          "artCue": "电梯内近景Mia/Kai半身纸箱距离过近；熟悉感擦边T；发型按设定板；脸在上55%",
          "artStatus": "ready",
          "characters": [
