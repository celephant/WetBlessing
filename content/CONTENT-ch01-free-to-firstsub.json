      "nodes": [
        {
          "nodeId": "n_open",
          "type": "dialogue",
          "speaker": "narrator",
          "text": "州立大学报到日。宿舍楼的电梯口堵着纸箱，空气里是纸皮和廉价香水味。",
          "assetId": "assets/scenes/ch01/n_open.webp",
          "artCue": "宿舍电梯厅全景日光纸箱，大构图；缺图用占位",
          "artStatus": "placeholder",
          "characters": [
            "kai"
          ],
          "advance": "n_see_both"
        },
        {
          "nodeId": "n_see_both",
          "type": "dialogue",
          "speaker": "narrator",
          "text": "电梯门开。Mia 抱着纸箱看见你；同时 Jade 带着迎新队擦肩而过。两个人都开口了。",
          "assetId": "assets/scenes/ch01/n_see_both.webp",
          "artCue": "电梯口双人同框：Mia抱箱左近景，Jade迎新队右路过，Kai可被两人叫到；半身大构图日系动漫；脸在上55%；底栏28%留给对话框勿烧UI",
          "artStatus": "ready",
          "characters": [
            "kai",
            "mia",
            "jade"
          ],
          "lines": [
            {
              "speaker": "mia",
              "text": "「Kai，手别插裤兜——箱子！」"
            },
            {
              "speaker": "jade",
              "text": "「哟，新生？登记桌那边缺人手。——哦，你认识她？」"
            }
          ],
          "choices": [
            {
              "choiceId": "c_help_mia",
              "text": "接招：箱子给我。",
              "next": "n_mia_edge_1",
              "delta": {
                "stats": {
                  "mia": {
                    "affection": 2,
                    "desire": 1
                  }
                }
              },
              "setFlags": {
                "helped_mia_box": true
              }
            },
            {
              "choiceId": "c_talk_jade",
              "text": "接招：登记桌？我可以去。",
              "next": "n_jade_desk",
              "delta": {
                "stats": {
