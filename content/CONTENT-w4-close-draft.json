          "artStatus": "placeholder",
          "characters": [
            "kai"
          ]
        },
        {
          "nodeId": "n_w4_morning",
          "type": "dialogue",
          "speaker": "narrator",
          "tier": "paid",
          "text": "《皱衣未说完》——晨光凌乱。肩线、皱衣、话说一半。体温还在，名分没有。",
          "choices": [
            {
              "choiceId": "c1",
              "text": "接招：别装无事。",
              "next": "n_w4_confront",
              "delta": {},
              "meta": {
                "statusHint": {
                  "axis": "rascal",
                  "delta": 1
                }
              }
            },
            {
              "choiceId": "c2",
              "text": "圆场：……先上课。",
              "next": "n_w4_confront",
              "delta": {},
              "meta": {
                "statusHint": {
                  "axis": "steady",
                  "delta": 1
                }
              }
            },
            {
              "choiceId": "c3",
              "text": "躲开：先走。",
              "next": "n_w4_confront",
              "delta": {},
              "meta": {
                "statusHint": {
                  "axis": "none",
                  "delta": 0
                }
              }
            }
          ],
          "assetId": "assets/scenes/w4/n_w4_morning.webp",
          "artCue": "晨光凌乱",
          "artStatus": "placeholder",
          "characters": [
            "kai"
          ],
          "camera": "close",
          "transition": "soft-zoom",
          "fx": "warm-veil",
          "lines": [
            {
              "speaker": "narrator",
              "text": "晨光切过皱衣。肩线还乱，呼吸未平——话说到一半就停。",
              "camera": "close",
              "transition": "soft-zoom",
              "fx": "warm-veil"
            },
            {
              "speaker": "narrator",
              "text": "体温还在。名分没有。走廊那头，选边的气口已经打开。",
              "camera": "close_alt",
              "transition": "softZoomCrop",
              "fx": "breath"
            }
          ]
        },
        {
          "nodeId": "n_w4_confront",
          "type": "dialogue",
          "speaker": "troy",
          "tier": "paid",
          "text": "《选边·现在》——Troy：「选边。现在。」",
          "choices": [
            {
              "choiceId": "c1",
              "text": "接招：挺我在乎的人。——挡在她前面。",
              "next": "n_w4_hub_pick",
              "delta": {},
              "setFlags": {
                "w4_stand": "protect"
              },
              "meta": {
                "statusHint": {
                  "axis": "rascal",
                  "delta": 1
                },
                "openIf": {
                  "comment": "INTENT only — engine not wired: rascal>=3 may surface bolder line「别挡她。滚。」; Status UI later",
                  "rascal_gte": 3
                }
              }
            },
            {
              "choiceId": "c2",
              "text": "圆场：别在这儿闹。",
              "next": "n_w4_hub_pick",
              "delta": {},
              "setFlags": {
                "w4_stand": "defuse"
              },
              "meta": {
                "statusHint": {
                  "axis": "steady",
                  "delta": 1
