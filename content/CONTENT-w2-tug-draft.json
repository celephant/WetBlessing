          "lines": [
            {
              "speaker": "narrator",
              "text": "食堂噪杂里，托盘砸在桌面——脆响像当众点名。Mia 坐下，笑不达眼，目光钉住你。",
              "camera": "mid",
              "transition": "dip",
              "fx": "afterimage"
