  "stages": [
    {
      "stageId": "stage_landing_funnel",
      "stageTitle": "入学夜 · 登录前",
      "order": 1,
      "entryNodeId": "n_funnel_01",
      "nodes": [
        {
          "nodeId": "n_funnel_01",
          "type": "dialogue",
          "speaker": "narrator",
          "text": "水还亮着。湿气贴着小臂。心跳已经先走了一步。",
          "assetId": "assets/scenes/heat/S06c.webp",
          "artCue": "S06c 夜池湿衣大腿毛巾 POV；漏斗第一剧情镜。不是大厅纸箱、不是四分站桩",
          "artStatus": "ready",
          "characters": ["kai", "lina"],
          "setFlags": { "funnel_step": 1 },
          "camera": "hold",
          "transition": "fade",
          "fx": "none",
          "choices": [
            {
              "choiceId": "c_f1_enter",
              "text": "走进派对。点一块地",
              "next": "n_funnel_02"
            }
          ]
        },
        {
          "nodeId": "n_funnel_02",
          "type": "dialogue",
          "speaker": "narrator",
          "text": "走近才听得见。点一块地。",
          "assetId": "assets/scenes/ch01/n_conflict.webp",
          "artCue": "S05 同一夜池整图；四热区描边，点谁谁开口；不 CSS 裁横图",
          "artStatus": "ready",
          "characters": ["kai", "mia", "jade", "lina", "rae"],
          "setFlags": { "funnel_step": 2 },
          "camera": "hold",
          "transition": "fade",
          "fx": "none",
          "choices": [
            {
              "choiceId": "c_f2_seen",
              "text": "看清她们。还站中间干什么",
              "next": "n_funnel_03"
            }
          ]
        },
        {
          "nodeId": "n_funnel_03",
          "type": "dialogue",
          "speaker": "mia",
          "text": "「还站中间干什么。」",
          "assetId": "assets/scenes/ch01/n_conflict.webp",
          "artCue": "S05 甲板扫视 Mia 侧门描边，不进床、不说白天纸箱",
          "artStatus": "ready",
          "characters": ["kai", "mia"],
          "setFlags": { "funnel_step": 3, "funnel_zone": "mia" },
          "camera": "hold",
          "transition": "fade",
          "choices": [
            {
              "choiceId": "c_f3_take",
              "text": "走近。她喊你过来",
              "next": "n_funnel_03_take"
            },
            {
              "choiceId": "c_f3_ask",
              "text": "先不走近。她只说了行",
              "next": "n_funnel_03_ask"
            }
          ]
        },
        {
          "nodeId": "n_funnel_03_take",
          "type": "dialogue",
          "speaker": "mia",
          "text": "「凯。过来。」",
          "assetId": "assets/scenes/ch01/n_conflict.webp",
          "characters": ["kai", "mia"],
          "camera": "hold",
          "advance": "n_funnel_04"
        },
        {
          "nodeId": "n_funnel_03_ask",
          "type": "dialogue",
          "speaker": "mia",
          "text": "「……行。」",
          "assetId": "assets/scenes/ch01/n_conflict.webp",
          "characters": ["kai", "mia"],
          "camera": "hold",
          "advance": "n_funnel_04"
        },
        {
          "nodeId": "n_funnel_04",
          "type": "dialogue",
          "speaker": "jade",
          "text": "「Kai。别动。就一张。」",
          "assetId": "assets/scenes/ch01/n_conflict.webp",
          "artCue": "S05 甲板扫视 Jade 台阶，不进干楼梯吻",
          "artStatus": "ready",
          "characters": ["kai", "jade"],
          "setFlags": { "funnel_step": 4, "funnel_zone": "jade" },
          "camera": "hold",
          "transition": "fade",
          "choices": [
            {
              "choiceId": "c_f4_take",
              "text": "站近一步。屏幕也要朝下",
              "next": "n_funnel_04_take"
            },
            {
              "choiceId": "c_f4_ask",
              "text": "问她拍了什么。这张她不给看",
              "next": "n_funnel_04_ask"
            }
          ]
        },
        {
          "nodeId": "n_funnel_04_take",
          "type": "dialogue",
          "speaker": "jade",
          "text": "「屏幕朝下。你的也是。」",
          "assetId": "assets/scenes/ch01/n_conflict.webp",
          "characters": ["kai", "jade"],
          "camera": "hold",
          "advance": "n_funnel_05"
        },
        {
          "nodeId": "n_funnel_04_ask",
          "type": "dialogue",
          "speaker": "jade",
          "text": "「刚才那张给迎新页。这张——没有。」",
          "assetId": "assets/scenes/ch01/n_conflict.webp",
          "characters": ["kai", "jade"],
          "camera": "hold",
          "advance": "n_funnel_05"
        },
        {
          "nodeId": "n_funnel_05",
          "type": "dialogue",
          "speaker": "lina",
          "text": "「挡道。」",
          "assetId": "assets/scenes/ch01/n_conflict.webp",
          "artCue": "S05 甲板扫视 Lina 跳台，不进毛巾特写",
          "artStatus": "ready",
          "characters": ["kai", "lina"],
          "setFlags": { "funnel_step": 5, "funnel_zone": "lina" },
          "camera": "hold",
          "transition": "fade",
          "choices": [
            {
              "choiceId": "c_f5_take",
              "text": "走近跳台。她叫你别盯",
              "next": "n_funnel_05_take"
            },
            {
              "choiceId": "c_f5_ask",
              "text": "叫她名字。跳台还亮着",
              "next": "n_funnel_05_ask"
            }
          ]
        },
        {
          "nodeId": "n_funnel_05_take",
          "type": "dialogue",
          "speaker": "lina",
          "text": "「别盯。」",
          "assetId": "assets/scenes/ch01/n_conflict.webp",
          "characters": ["kai", "lina"],
          "camera": "hold",
          "advance": "n_funnel_06"
        },
        {
          "nodeId": "n_funnel_05_ask",
          "type": "dialogue",
          "speaker": "lina",
          "text": "「别叫我名字。跳台还亮着。」",
          "assetId": "assets/scenes/ch01/n_conflict.webp",
          "characters": ["kai", "lina"],
          "camera": "hold",
          "advance": "n_funnel_06"
        },
        {
          "nodeId": "n_funnel_06",
          "type": "dialogue",
          "speaker": "narrator",
          "text": "对门缝涌出热气。钩上的证晃了一下。蒸汽贴着嘴。",
          "assetId": "assets/scenes/heat/S04.webp",
          "artCue": "S04 门缝窥视；18 证入画不普法",
          "artStatus": "ready",
          "characters": ["kai", "rae"],
          "setFlags": { "funnel_step": 6, "funnel_zone": "rae" },
          "camera": "hold",
          "transition": "fade",
          "lines": [
            {
              "speaker": "rae",
              "text": "「……有人。」"
            }
          ],
          "choices": [
            {
              "choiceId": "c_f6_take",
              "text": "手不放。先别出声",
              "next": "n_funnel_06_take"
            },
            {
              "choiceId": "c_f6_ask",
              "text": "松手。他们能听见呼吸",
              "next": "n_funnel_06_ask"
            }
          ]
        },
        {
          "nodeId": "n_funnel_06_take",
          "type": "dialogue",
          "speaker": "rae",
          "text": "「先别出声。……唔。」",
          "assetId": "assets/scenes/heat/S04.webp",
          "characters": ["kai", "rae"],
          "camera": "hold",
          "advance": "n_funnel_07"
        },
        {
          "nodeId": "n_funnel_06_ask",
          "type": "dialogue",
          "speaker": "rae",
          "text": "「小点声。他们能听见呼吸。」",
          "assetId": "assets/scenes/heat/S04.webp",
          "characters": ["kai", "rae"],
          "camera": "hold",
          "advance": "n_funnel_07"
        },
        {
          "nodeId": "n_funnel_07",
          "type": "dialogue",
          "speaker": "narrator",
          "text": "下一张图装不下两块地。",
          "assetId": "assets/scenes/ch01/n_conflict.webp",
          "artCue": "S05 夜池广角五键真选择；下一张必须换静帧",
          "artStatus": "ready",
          "characters": ["kai", "mia", "jade", "lina", "rae"],
          "setFlags": { "funnel_step": 7 },
          "camera": "hold",
          "transition": "fade",
          "choices": [
            {
              "choiceId": "c_f7_mia",
              "text": "接招：侧门。床头只剩一盏灯",
              "next": "n_funnel_08_mia",
              "setFlags": {
                "went_with": "mia"
              }
            },
            {
              "choiceId": "c_f7_jade",
              "text": "接招：上台阶。砖还凉、她却热",
              "next": "n_funnel_08_jade",
              "setFlags": {
                "went_with": "jade"
              }
            },
            {
              "choiceId": "c_f7_lina",
              "text": "接招：走向跳台。毛巾砸进怀里",
              "next": "n_funnel_08_lina",
              "setFlags": {
                "went_with": "lina"
              }
            },
            {
              "choiceId": "c_f7_rae",
              "text": "接招：走向冒气的门。门缝还开着",
              "next": "n_funnel_08_rae",
              "setFlags": {
                "went_with": "rae"
              }
            },
            {
              "choiceId": "c_f7_none",
              "text": "躲开：谁也不跟。手机还是亮了",
              "next": "n_funnel_08_none",
              "setFlags": {
                "went_with": "none"
              }
            }
          ]
        },
        {
          "nodeId": "n_funnel_08_mia",
          "type": "dialogue",
          "speaker": "narrator",
          "text": "侧门一关。灯只留床头那盏。滚烫顺着腰线。她膝盖不容拒绝地往前。",
          "assetId": "assets/scenes/heat/S06a.webp",
          "artCue": "S06a 俯压床：羞耻咬唇、腰侧手、腿脚砸镜头；不是吻图",
          "artStatus": "ready",
          "characters": ["kai", "mia"],
          "setFlags": { "funnel_step": 8 },
          "camera": "hold",
          "transition": "fade",
          "fx": "warm-tint",
          "lines": [
            {
              "speaker": "mia",
              "text": "「唔……！手拿开。……不、别停。」"
            }
          ],
          "choices": [
            {
              "choiceId": "c_f8_mia",
              "text": "再近。心跳空了一拍",
              "next": "n_funnel_09"
            }
          ]
        },
        {
          "nodeId": "n_funnel_08_jade",
          "type": "dialogue",
          "speaker": "narrator",
          "text": "台阶转进阴影。闪光关了。砖还凉，她小臂却热。",
          "assetId": "assets/scenes/heat/S06b.webp",
          "artCue": "S06b 干楼梯：一腿踩砖、相机已关；禁止雨水；不是吻图",
          "artStatus": "ready",
          "characters": ["kai", "jade"],
          "setFlags": { "funnel_step": 8 },
          "camera": "hold",
          "transition": "fade",
          "fx": "warm-tint",
          "lines": [
            {
              "speaker": "jade",
              "text": "「进来。……别、别给别人看。」"
            }
          ],
          "choices": [
            {
              "choiceId": "c_f8_jade",
              "text": "再近。一张拼贴没有字",
              "next": "n_funnel_09"
            }
          ]
        },
        {
          "nodeId": "n_funnel_08_lina",
          "type": "dialogue",
          "speaker": "narrator",
          "text": "你一走近跳台，毛巾砸进怀里。视线只剩她的眼睛。湿气从布边漏出来。腿侧发凉，掌心却热。",
          "assetId": "assets/scenes/heat/S06c.webp",
          "artCue": "S06c 毛巾 POV：室内夜池、湿大腿；无雨；不是吻图",
          "artStatus": "ready",
          "characters": ["kai", "lina"],
          "setFlags": { "funnel_step": 8 },
          "camera": "hold",
          "transition": "fade",
          "fx": "warm-tint",
          "lines": [
            {
              "speaker": "lina",
              "text": "「别盯。……不、拿着就拿着。」"
            }
          ],
          "choices": [
            {
              "choiceId": "c_f8_lina",
              "text": "再近。两张脸在抢一只手",
              "next": "n_funnel_09"
            }
          ]
        },
        {
          "nodeId": "n_funnel_08_rae",
          "type": "dialogue",
          "speaker": "narrator",
          "text": "楼道空了。水手领还湿。蒸汽贴着后颈。",
          "assetId": "assets/scenes/heat/n_heat_neck_rae.webp",
          "artCue": "S06d 过肩颈侧：水手领、湿砖脚尖、钩上学生证；不是吻图",
          "artStatus": "ready",
          "characters": ["kai", "rae"],
          "setFlags": { "funnel_step": 8 },
          "camera": "hold",
          "transition": "fade",
          "fx": "warm-tint",
          "lines": [
            {
              "speaker": "rae",
              "text": "「门缝还开着。……从里面关。别、别出声。」"
            }
          ],
          "choices": [
            {
              "choiceId": "c_f8_rae",
              "text": "再近。今天下午那张图",
              "next": "n_funnel_09"
            }
          ]
        },
        {
          "nodeId": "n_funnel_08_none",
          "type": "dialogue",
          "speaker": "narrator",
          "text": "楼道空了。手机还是亮了。掌心的热还没退。",
          "assetId": "assets/scenes/ch01/n_free_soft_exit.webp",
          "artCue": "C1-D2 空廊；不是大厅 n_open",
          "artStatus": "ready",
          "characters": ["kai"],
          "setFlags": { "funnel_step": 8 },
          "camera": "hold",
          "transition": "fade",
          "choices": [
            {
              "choiceId": "c_f8_none",
              "text": "再近。群里没有字",
              "next": "n_funnel_09"
            }
          ]
        },
        {
          "nodeId": "n_funnel_09",
          "type": "dialogue",
          "speaker": "narrator",
          "text": "新生群。一张拼贴。没有字。心跳空了一拍。",
          "assetId": "assets/scenes/ch01/n_sms_auto.webp",
          "artCue": "S07 手机近、拼贴剪影；勿烧聊天气泡；公事条子 UI，Reina 不开口",
          "artStatus": "ready",
          "characters": ["kai"],
          "setFlags": { "funnel_step": 9 },
          "camera": "hold",
          "transition": "fade",
          "fx": "vignette",
          "lines": [
            {
              "speaker": "narrator",
              "text": "两张脸在抢同一只手。今天下午。"
            }
          ],
          "choices": [
            {
              "choiceId": "c_f9_open",
              "text": "点开那张拼贴。已经走到图跟前",
              "next": "n_funnel_10"
            }
          ]
        },
        {
          "nodeId": "n_funnel_10",
          "type": "dialogue",
          "speaker": "narrator",
          "text": "你已经走到这张图跟前。",
          "assetId": "assets/scenes/ch01/n_sms_auto.webp",
          "artCue": "S07 拼贴下半被 28% 底栏挡住；注册表单在底栏",
