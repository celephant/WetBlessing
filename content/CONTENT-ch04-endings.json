            "lina"
          ],
          "artCue": "S24 该锁的楼：夜水，不给称呼",
          "lines": [
            {
              "speaker": "lina",
              "text": "「水不会等。今晚它等了。」",
              "camera": "hold",
              "transition": "fade"
            },
            {
              "speaker": "narrator",
              "text": "她还是不给称呼。楼是锁的。",
              "camera": "hold",
              "transition": "fade"
