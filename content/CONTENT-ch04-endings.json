            "rae"
          ],
          "artCue": "S24 从里面关：世界在门外",
          "lines": [
            {
              "speaker": "rae",
              "text": "「隔墙听不见了。」",
              "camera": "hold",
              "transition": "fade"
            },
            {
              "speaker": "narrator",
              "text": "世界在门外。",
              "camera": "hold",
              "transition": "fade"
