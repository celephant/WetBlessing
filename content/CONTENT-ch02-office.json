        },
        {
          "nodeId": "n_s13_jade",
          "type": "dialogue",
          "speaker": "narrator",
          "text": "托盘轻轻磕上桌沿。Jade 坐下，笑还在唇边，眼里没有。",
          "assetId": "assets/scenes/ch02/S13.webp",
          "artCue": "S13 食堂公开点名 · Jade；托盘沿近，邻桌侧耳",
          "artStatus": "ready",
          "characters": ["kai", "jade"],
          "camera": "hold",
          "transition": "fade",
          "fx": "afterimage",
          "setFlags": {
            "cafe_creditor": "jade"
          },
          "lines": [
            {
              "speaker": "narrator",
              "text": "邻桌有人把杯子放下。",
              "camera": "hold",
              "transition": "fade"
            },
            {
              "speaker": "jade",
              "text": "「合影很好看。——空着的那一格呢？」",
              "camera": "hold",
              "transition": "fade"
            },
            {
              "speaker": "jade",
              "text": "「你鸽了我。笑还在迎新页上。」",
              "camera": "hold",
              "transition": "fade"
            }
          ],
          "choices": [
            {
              "choiceId": "c_s13_ok",
              "text": "接招：「是我的锅。」",
              "next": "n_s13_after",
              "delta": {
                "stats": { "jade": { "affection": 2 } }
              },
              "setFlags": { "s13_reply": "ok", "cafe_creditor": "jade" }
