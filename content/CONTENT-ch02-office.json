          "camera": "hold",
          "transition": "fade",
          "fx": "vignette",
          "lines": [
            {
              "speaker": "reina",
              "text": "「我还是你的讲师。」",
              "camera": "hold",
              "transition": "fade"
            },
            {
              "speaker": "narrator",
              "text": "门锁开了。走廊的声音回来。",
              "camera": "hold",
              "transition": "fade"
            }
          ]
        },
        {
          "nodeId": "n_s14_kiss",
          "type": "dialogue",
          "speaker": "narrator",
          "text": "嘴对上了。眼镜框磕到你额角。衬衫还扣着，丝还在。",
          "assetId": "assets/scenes/ch02/S14-kiss.webp",
          "artCue": "S14 付费：嘴对上，仍着衣，无生殖器；可阿黑颜",
          "artStatus": "ready",
          "characters": ["kai", "reina"],
          "advance": "n_ch02_settle",
          "camera": "hold",
          "transition": "soft-zoom",
          "fx": "warm-veil",
          "lines": [
            {
              "speaker": "reina",
              "text": "「不行……看我。」",
              "camera": "hold",
              "transition": "fade"
            },
            {
              "speaker": "narrator",
              "text": "她按着你的肩，又像要推开。没有再往下。",
              "camera": "hold",
              "transition": "fade"
            },
            {
              "speaker": "reina",
              "text": "「……还是讲师。」",
              "camera": "hold",
              "transition": "fade"
            }
          ]
        },
