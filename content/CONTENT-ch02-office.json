            }
          ]
        },
        {
          "nodeId": "n_s14_abort",
          "type": "dialogue",
          "speaker": "narrator",
          "text": "她偏开。黑丝从桌沿滑回去。",
          "assetId": "assets/scenes/ch02/S14-abort.webp",
          "artCue": "S14 免费中止：她偏开，仍是讲师；门将开",
          "artStatus": "ready",
          "characters": ["kai", "reina"],
