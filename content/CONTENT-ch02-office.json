            {
              "choiceId": "c_s13_soft",
              "text": "圆场：「……灯太亮了。」",
              "next": "n_s13_after",
              "setFlags": { "s13_reply": "soft", "cafe_creditor": "jade" }
            },
            {
              "choiceId": "c_s13_dodge",
              "text": "躲开：低头看托盘。",
              "next": "n_s13_after",
              "delta": { "tension": 2 },
              "setFlags": { "s13_reply": "dodge", "cafe_creditor": "jade" }
