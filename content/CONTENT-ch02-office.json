        {
          "nodeId": "n_s13_after",
          "type": "dialogue",
          "speaker": "narrator",
          "text": "邻桌筷子又响起来。她已经站了，托盘没拿完。",
          "assetId": "assets/scenes/ch02/S13.webp",
          "artCue": "S13 收场：公开点名结束，邮件仍在口袋",
          "artStatus": "ready",
          "characters": ["kai"],
          "advance": "n_s14_office",
          "camera": "hold",
          "transition": "fade",
          "fx": "warm_dust",
          "lines": [
            {
              "speaker": "narrator",
              "text": "口袋里那封邮件还在。教員室不会等人。",
              "camera": "hold",
              "transition": "fade"
            }
          ]
        },
        {
          "nodeId": "n_s14_office",
          "type": "dialogue",
          "speaker": "narrator",
          "text": "教員室。打印的拼贴平摊在桌上——电梯口的人，和派对里另一个人。",
          "assetId": "assets/scenes/ch02/S14.webp",
          "artCue": "S14 仰坐学生位：拼贴在桌、门未锁、讲师口吻；黑丝桌沿占前 1/3",
          "artStatus": "ready",
          "characters": ["kai", "reina"],
          "advance": "n_s14_silk",
          "camera": "hold",
          "transition": "fade",
          "fx": "warm_dust",
          "lines": [
            {
              "speaker": "reina",
              "text": "「坐下。把门带上。——先不用锁。」",
              "camera": "hold",
              "transition": "fade"
            },
            {
              "speaker": "narrator",
              "text": "椅背离桌沿只有一掌。她没请你喝水。",
              "camera": "hold",
              "transition": "fade"
            },
            {
              "speaker": "reina",
              "text": "「新生研讨。我二十九岁。这不是约会。」",
              "camera": "hold",
              "transition": "fade"
            },
            {
              "speaker": "reina",
              "text": "「解释。一句话。谁先谁后。」",
              "camera": "hold",
              "transition": "fade"
            }
          ]
        },
        {
          "nodeId": "n_s14_silk",
          "type": "dialogue",
          "speaker": "narrator",
          "text": "高跟鞋在桌下交叠。黑丝压着桌沿，近到你没法把眼睛抬回去。",
          "assetId": "assets/scenes/ch02/S14.webp",
          "artCue": "S14 黑丝桌沿近大远小；表情仍是讲师；百叶缝有人影",
          "artStatus": "ready",
          "characters": ["kai", "reina"],
          "advance": "n_s14_lock",
          "camera": "hold",
          "transition": "fade",
          "fx": "afterimage",
          "lines": [
            {
              "speaker": "reina",
              "text": "「看我。不是看腿。」",
              "camera": "hold",
              "transition": "fade"
            },
            {
              "speaker": "narrator",
              "text": "声音仍是办公室的。百叶缝里有人影晃过。",
              "camera": "hold",
              "transition": "fade"
            }
          ]
        },
        {
          "nodeId": "n_s14_lock",
          "type": "dialogue",
          "speaker": "reina",
          "text": "「……门，还是锁上吧。走廊有人。」",
          "assetId": "assets/scenes/ch02/S14-lock.webp",
          "artCue": "S14 锁门：百叶缝窥视 + 走廊人影；鞋跟/丝可出画",
          "artStatus": "ready",
          "characters": ["kai", "reina"],
          "advance": "n_s14_wall",
          "camera": "hold",
          "transition": "fade",
          "fx": "afterimage",
          "setFlags": {
            "office_locked": true
          },
          "lines": [
            {
              "speaker": "narrator",
              "text": "锁舌进槽。她的手还按在门上，停了一秒。",
              "camera": "hold",
              "transition": "fade"
            },
            {
              "speaker": "reina",
              "text": "「学生证。放桌上。」",
              "camera": "hold",
              "transition": "fade"
            }
          ]
        },
        {
          "nodeId": "n_s14_wall",
          "type": "dialogue",
          "gate": "first_sub",
          "speaker": "narrator",
          "text": "拼贴还摊着。她绕过桌角，停在你椅子前面。",
          "assetId": "assets/scenes/ch02/S14.webp",
          "artCue": "S14 墙：免费中止 / 付费嘴对上；静帧",
          "artStatus": "ready",
          "characters": ["kai", "reina"],
          "camera": "hold",
          "transition": "dip",
          "fx": "tension_hold",
          "lines": [
            {
              "speaker": "narrator",
              "text": "免费只够听到下一句之前的沉默。",
              "camera": "hold",
              "transition": "fade"
            }
          ],
          "choices": [
            {
              "choiceId": "c_s14_free",
              "text": "「我先走。」",
              "next": "n_s14_abort",
              "delta": { "tension": 1 },
              "gateChoice": "free"
