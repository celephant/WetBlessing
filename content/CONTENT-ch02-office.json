        {
          "nodeId": "n_s13_mia",
          "type": "dialogue",
          "speaker": "narrator",
          "text": "托盘沿顶到你胸口。Mia 坐下，没打招呼。",
          "assetId": "assets/scenes/ch02/S13.webp",
          "artCue": "S13 隔着托盘的双人中景：当众叫出鸽子的嘴→托盘→邻桌耳朵；公开羞红，衣服穿好",
          "artStatus": "ready",
          "characters": ["kai", "mia"],
          "camera": "hold",
          "transition": "fade",
          "fx": "afterimage",
          "setFlags": {
            "cafe_creditor": "mia"
          },
          "lines": [
            {
              "speaker": "narrator",
              "text": "邻桌有人把筷子停住。",
              "camera": "hold",
              "transition": "fade"
            },
            {
              "speaker": "mia",
              "text": "「派对合影很好看。——我门口那一下呢？你鸽了我，Kai。」",
              "camera": "hold",
              "transition": "fade"
            },
            {
              "speaker": "mia",
              "text": "「笑啊。他们都在听。」",
              "camera": "hold",
              "transition": "fade"
            }
          ],
          "choices": [
            {
              "choiceId": "c_s13_ok",
              "text": "接招：「是我的锅。」",
              "next": "n_s13_after",
              "delta": {
