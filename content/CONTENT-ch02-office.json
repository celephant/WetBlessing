          ]
        },
        {
          "nodeId": "n_s13_both",
          "type": "dialogue",
          "speaker": "narrator",
          "text": "一张桌子，两个人。托盘一响，邻桌安静半秒。",
          "assetId": "assets/scenes/ch02/S13.webp",
          "artCue": "S13 食堂双人点名；衣服穿好，公开羞红",
          "artStatus": "ready",
          "characters": ["kai", "mia", "jade"],
          "camera": "hold",
          "transition": "fade",
          "fx": "afterimage",
          "setFlags": {
            "cafe_creditor": "both"
          },
          "lines": [
            {
              "speaker": "mia",
              "text": "「门口很好等。——你鸽了谁，自己记得。」",
              "camera": "hold",
              "transition": "fade"
            },
            {
              "speaker": "jade",
              "text": "「合影位也是。人会消失，页上的笑不会。」",
              "camera": "hold",
              "transition": "fade"
            }
          ],
          "choices": [
            {
              "choiceId": "c_s13_ok",
              "text": "接招：「两边都是我的锅。」",
              "next": "n_s13_after",
